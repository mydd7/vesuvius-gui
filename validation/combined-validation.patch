+        let path = format!(
+            "{}/tests/data/PHerc0800-blocksize/{blocksize}",
+            env!("CARGO_MANIFEST_DIR")
+        );
+        let ctx = ZarrArray::<3, u8>::from_path(&path).into_ctx().into_ctx();
+        for z in 0..3 {
+            for y in 0..32 {
+                for x in 0..32 {
+                    assert_eq!(
+                        ctx.get([z, y, x]),
+                        Some(reference[(z * 32 + y) * 32 + x]),
+                        "blocksize={blocksize} at {z},{y},{x}"
+                    );
+                }
+            }
+        }
+    }
+}
